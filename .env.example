# Copy this file to .env and fill in values.
# .env is gitignored — never commit it.

IRIS_PASSWORD=change_me_now
IRIS_USERNAME=_SYSTEM
# Running another project cloned from this template at the same time? Give
# it different ports here - these two both default the same way everywhere.
IRIS_PORT=52773
IRIS_SUPER_PORT=1972

# When connecting from a process running OUTSIDE this compose network
# (a local script or another container), use host.docker.internal as the
# host on Windows/Mac instead of "localhost".
# IRIS_HOST=host.docker.internal

